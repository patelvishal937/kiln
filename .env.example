# Kiln runs inside your Claude Code / Codex session. There is NO model API key here —
# the agent is the model, and the MCP servers (Greta, Apify, Volanea, Higgsfield...) are
# whatever that session has connected. This file only configures the Python helper scripts
# and the budget policy. Everything here is optional except the budgets.

# --- Greta (informational: the connection itself lives in your MCP config) ---
GRETA_MCP_URL=https://staging-mcp.greta.sh/mcp

# --- Budgets (Greta credits) — the policy the agent is held to ---
RUN_CREDIT_CAP=150
PER_CALL_CREDIT_CAP=25
GROWTH_NIGHTLY_CREDIT_LIMIT=10
GROWTH_TASKS_PER_NIGHT=2
TIMEZONE=Asia/Kolkata

# --- HeyGen avatar video (optional; used by scripts/media_steps.py) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# --- Asset hosting for rendered videos (S3-compatible, optional) ---
# Without this, videos render locally but cannot be embedded on the site.
ASSET_S3_BUCKET=
ASSET_S3_PREFIX=kiln
ASSET_S3_ENDPOINT_URL=
ASSET_PUBLIC_BASE_URL=
